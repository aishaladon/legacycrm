# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://aherxqnaufiaotspzrbn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never exposed to the browser. Pull from the Supabase
# dashboard (Project Settings > API > service_role secret key).
SUPABASE_URL=https://aherxqnaufiaotspzrbn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Phase 2: WordPress application password for aishaladon.com (reads
# WooCommerce orders and LearnDash enrollments via wc/v3 and ldlms/v2).
# Generate in wp-admin: Users > Profile > Application Passwords.
WORDPRESS_URL=https://aishaladon.com
WORDPRESS_APP_USERNAME=
WORDPRESS_APP_PASSWORD=

# Phase 2: Google OAuth (Gmail, Calendar, Drive/Meet transcripts) for
# Aisha's own Google account. See docs/google-oauth-setup.md to create the
# OAuth client and mint the refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
OWNER_EMAIL=aishaladon@gmail.com

# Phase 2: shared secret required on every /api/sync/* request
# (Authorization: Bearer <value>). Generate with: openssl rand -hex 32
SYNC_SECRET=

# Phase 5+: WhatsApp Business Platform API (only needed once sending is
# automated — staying manual for now per the build plan).
# WHATSAPP_API_KEY=
